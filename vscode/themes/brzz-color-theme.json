  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#576e75",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc Comment Tags",
      "scope": [
        "comment.block.documentation storage.type",
        "comment.block.documentation punctuation.definition",
        "comment.block.documentation variable.parameter"
      ],
      "settings": {
        "foreground": "#899c9e",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.cast",
        "keyword.operator.sizeof",
        "keyword.operator.logical.python",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#d73482"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#a4b9ba"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#ce4c02"
      }
    },
    {
      "name": "String Escapes",
      "scope": [
        "constant.character.escape",
        "string.quoted constant.character"
      ],
      "settings": {
        "foreground": "#df7459"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#df7459"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "constant.language",
        "constant.language.boolean",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#8ba400"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "meta.function.parameters variable",
        "meta.parameter",
        "support.variable.property",
        "variable",
        "variable.other",
        "variable.other.object.property",
        "variable.other.property",
        "variable.other.readwrite",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#2faaa0"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "meta.method-call entity.name.function"
      ],
      "settings": {
        "foreground": "#2c8dd7"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.type.enum",
        "entity.name.type.interface",
        "entity.other.inherited-class",
        "support.class"
      ],
      "settings": {
        "foreground": "#706fc9"
      }
    },
    {
      "name": "Type Parameters",
      "scope": [
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#74dfff"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.type.namespace",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#58b6ce"
      }
    },
    {
      "name": "Attributes/Annotations/Preprocessor",
      "scope": [
        "entity.name.function.decorator",
        "entity.other.attribute-name",
        "keyword.control.directive",
        "meta.attribute",
        "meta.decorator",
        "meta.preprocessor",
        "punctuation.definition.directive",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#bb9200"
      }
    },
    {
      "name": "HTML/XML Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#d73482"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#d73482"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#2faaa0"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css",
        "meta.property-value.css"
      ],
      "settings": {
        "foreground": "#ce4c02"
      }
    },
    {
      "name": "JSON Keys",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#2faaa0"
      }
    },
    {
      "name": "JSON Values",
      "scope": [
        "string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#ce4c02"
      }
    },
    {
      "name": "YAML Keys",
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#2faaa0"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "heading.1.markdown entity.name",
        "heading.2.markdown entity.name",
        "heading.3.markdown entity.name",
        "heading.4.markdown entity.name",
        "heading.5.markdown entity.name",
        "heading.6.markdown entity.name",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#a4b9ba",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#a4b9ba",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#a4b9ba",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw.block"
      ],
      "settings": {
        "foreground": "#899c9e"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#6a8189"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#fd8375"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#ff6961"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#a4b9ba",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Diff Added",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#8ba400"
      }
    },
    {
      "name": "Diff Removed",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#ff6961"
      }
    },
    {
      "name": "Diff Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#2c8dd7"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#58b6ce",
    "type": "#706fc9",
    "class": "#706fc9",
    "enum": "#706fc9",
    "interface": "#706fc9",
    "struct": "#706fc9",
    "typeParameter": "#74dfff",
    "parameter": "#2faaa0",
    "variable": "#2faaa0",
    "property": "#2faaa0",
    "enumMember": "#8ba400",
    "event": "#2faaa0",
    "function": "#2c8dd7",
    "method": "#2c8dd7",
    "macro": "#bb9200",
    "keyword": "#d73482",
    "modifier": "#d73482",
    "comment": "#576e75",
    "string": "#ce4c02",
    "number": "#df7459",
    "regexp": "#fd8375",
    "operator": "#a4b9ba"
  }
}
